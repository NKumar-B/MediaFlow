# Firebase Client-Side Configuration (Public / Safe for Browser)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Cloudflare R2 & HLS Serverless Secrets (SERVER-ONLY / Vercel Environment Variables)
# DO NOT prefix these with VITE_ to keep them strictly private on the backend!
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=mediaflow
R2_PUBLIC_URL=https://cdn.yourcustomdomain.com

# Demo Development HLS Fallback Stream
VITE_DEMO_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
